# Supabase project credentials (Settings > API in your Supabase dashboard)
# The anon key is safe to expose in the browser ONLY because Row Level Security
# policies (see supabase/migrations) enforce every permission server-side.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
